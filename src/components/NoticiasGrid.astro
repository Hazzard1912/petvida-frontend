---
import { getNoticias } from '../lib/strapi';
import type { INoticia } from '../types/strapi';

let noticias: INoticia[] = [];

try {
  const all = await getNoticias();
  noticias = all.slice(0, 3);
} catch (error) {
  console.error('No se pudieron cargar las noticias. Usando datos de respaldo.');
}

const formatDate = (dateStr: string): string => {
  if (!dateStr) return '';
  return new Date(dateStr).toLocaleDateString('es-CO', {
    day: '2-digit',
    month: 'short',
    year: 'numeric',
  });
};
---

<section class="w-screen relative left-1/2 right-1/2 -mx-[50vw] py-20 md:py-28 lg:py-32 pb-0" style="background-color: #FFF5FA;">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6 mb-16">
      <div class="flex items-center gap-3">
        <svg class="w-7 h-7 md:w-8 md:h-8" viewBox="0 0 24 24" fill="currentColor" style="color: #F42476;">
          <path d="M12 2c-2.2 0-4 1.8-4 4s1.8 4 4 4 4-1.8 4-4-1.8-4-4-4zm0 10c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm-6 0c-.6 0-1 .4-1 1s.4 1 1 1 1-.4 1-1-.4-1-1-1zm12 0c-.6 0-1 .4-1 1s.4 1 1 1 1-.4 1-1-.4-1-1-1z"/>
        </svg>
        <h2 class="text-4xl md:text-5xl font-extrabold" style="color: #F42476; font-family: var(--font-display);">
          Noticias
        </h2>
      </div>
      <a
        href="/noticias"
        class="hidden md:inline-flex items-center gap-2 text-base font-bold transition-colors hover:opacity-80"
        style="color: #20C8F1; font-family: var(--font-ui);"
      >
        Ver todas las noticias →
      </a>
    </div>

    {noticias.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
        {noticias.map((noticia) => (
          <article class="bg-white rounded-3xl shadow-sm hover:shadow-md transition-all duration-300 overflow-hidden flex flex-col border border-stone-100">
            <a href={`/noticias/${noticia.slug}`} class="block">
              {noticia.imagen?.url ? (
                <div class="w-full h-44 overflow-hidden bg-stone-100">
                  <img
                    src={noticia.imagen.url}
                    alt={noticia.imagen.alternativeText || noticia.titulo}
                    class="w-full h-full object-cover transition duration-500 hover:scale-105"
                    loading="lazy"
                  />
                </div>
              ) : (
                <div class="w-full h-44 flex items-center justify-center" style="background: linear-gradient(135deg, #FFCBDE, #FFC1D5);">
                  <span class="text-5xl">🐾</span>
                </div>
              )}
            </a>

            <div class="p-6 flex flex-col flex-grow">
              <time class="text-xs font-bold mb-3 uppercase tracking-[0.18em]" style="color: #F42476; font-family: var(--font-ui);" datetime={noticia.fecha}>
                {formatDate(noticia.fecha)}
              </time>

              <h3 class="text-lg font-bold mb-2 line-clamp-2" style="color: #1a1a1a; font-family: var(--font-title);">
                {noticia.titulo}
              </h3>

              <p class="text-sm leading-relaxed mb-4 flex-grow line-clamp-2" style="color: #666; font-family: var(--font-body);">
                {noticia.resumen}
              </p>

              <a
                href={`/noticias/${noticia.slug}`}
                class="inline-flex items-center gap-1 text-sm font-bold transition-colors hover:opacity-80 w-fit"
                style="color: #F42476; font-family: var(--font-ui);"
              >
                Leer más →
              </a>
            </div>
          </article>
        ))}
      </div>
    ) : (
      <div class="text-center py-16">
        <p class="text-stone-500" style="font-family: var(--font-body);">No hay noticias disponibles por el momento.</p>
      </div>
    )}

    <div class="mt-10 text-center md:hidden">
      <a
        href="/noticias"
        class="inline-flex items-center gap-2 text-base font-bold transition-colors hover:opacity-80"
        style="color: #20C8F1; font-family: var(--font-ui);"
      >
        Ver todas las noticias →
      </a>
    </div>
  </div>
</section>
