---
import { actions, isInputError } from 'astro:actions';

interface Props {
  pet: {
    documentId: string;
    name: string;
  };
}

const { pet } = Astro.props;
const result = Astro.getActionResult(actions.createAdoptionRequestAction);
const inputErrors = isInputError(result?.error) ? result.error.fields : {};
---

<div class="rounded-3xl bg-white p-8 shadow-sm">
  <h3 class="text-2xl font-bold text-stone-900">Solicitud de adopcion</h3>
  <p class="mt-2 text-sm text-stone-600">Completa el formulario para iniciar el proceso con {pet.name}.</p>

  {result?.data?.success === true ? (
    <div class="mt-6 rounded-2xl border border-emerald-200 bg-emerald-50 p-4 text-emerald-800">
      <p class="font-semibold">Solicitud enviada</p>
      <p class="text-sm mt-1">{result.data.message}</p>
    </div>
  ) : null}

  {result?.data?.success === false ? (
    <div class="mt-6 rounded-2xl border border-red-200 bg-red-50 p-4 text-red-800">
      <p class="font-semibold">No se pudo enviar la solicitud</p>
      <p class="text-sm mt-1">{result.data.message}</p>
    </div>
  ) : null}

  <form method="POST" action={actions.createAdoptionRequestAction} class="mt-6 space-y-4">
    <input type="hidden" name="pet" value={pet.documentId} />

    <div>
      <label class="block text-sm font-medium text-stone-700">Nombre completo</label>
      <input type="text" name="name" required class="mt-1 w-full rounded-xl border border-stone-300 px-3 py-2.5" />
      {inputErrors.name ? <p class="mt-1 text-xs text-red-600">{inputErrors.name.join(', ')}</p> : null}
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <label class="block text-sm font-medium text-stone-700">Email</label>
        <input type="email" name="email" required class="mt-1 w-full rounded-xl border border-stone-300 px-3 py-2.5" />
        {inputErrors.email ? <p class="mt-1 text-xs text-red-600">{inputErrors.email.join(', ')}</p> : null}
      </div>
      <div>
        <label class="block text-sm font-medium text-stone-700">Telefono</label>
        <input type="tel" name="phone" required class="mt-1 w-full rounded-xl border border-stone-300 px-3 py-2.5" />
        {inputErrors.phone ? <p class="mt-1 text-xs text-red-600">{inputErrors.phone.join(', ')}</p> : null}
      </div>
    </div>

    <div>
      <label class="block text-sm font-medium text-stone-700">Direccion</label>
      <input type="text" name="address" required class="mt-1 w-full rounded-xl border border-stone-300 px-3 py-2.5" />
      {inputErrors.address ? <p class="mt-1 text-xs text-red-600">{inputErrors.address.join(', ')}</p> : null}
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <label class="block text-sm font-medium text-stone-700">Barrio de residencia</label>
        <input type="text" name="neighborhood" required class="mt-1 w-full rounded-xl border border-stone-300 px-3 py-2.5" />
        {inputErrors.neighborhood ? <p class="mt-1 text-xs text-red-600">{inputErrors.neighborhood.join(', ')}</p> : null}
      </div>
      <div>
        <label class="block text-sm font-medium text-stone-700">Edad</label>
        <input type="number" name="age" required min="18" class="mt-1 w-full rounded-xl border border-stone-300 px-3 py-2.5" />
        {inputErrors.age ? <p class="mt-1 text-xs text-red-600">{inputErrors.age.join(', ')}</p> : null}
      </div>
    </div>

    <div>
      <label class="block text-sm font-medium text-stone-700">Motivo de adopcion</label>
      <textarea name="adoptionReason" rows="4" required class="mt-1 w-full rounded-xl border border-stone-300 px-3 py-2.5"></textarea>
      {inputErrors.adoptionReason ? <p class="mt-1 text-xs text-red-600">{inputErrors.adoptionReason.join(', ')}</p> : null}
    </div>

    <button type="submit" class="w-full rounded-xl bg-emerald-600 px-4 py-3 font-semibold text-white transition hover:bg-emerald-700">
      Enviar solicitud de adopcion
    </button>
  </form>
</div>
