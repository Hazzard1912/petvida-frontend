---
const currentPath = new URL(Astro.request.url).pathname;
const navItems = [
  { href: '/', label: 'Inicio' },
  { href: '/adopta', label: 'Adoptar' },
  { href: '/ayudanos', label: 'Donar' },
  { href: '/noticias', label: 'Noticias' },
  { href: '/contacto', label: 'Contacto' },
];
---

<header class="sticky top-0 z-40 w-full site-header">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <div class="flex items-center gap-3">
      <span class="text-2xl">🐾</span>
      <a href="/" class="brand-logo">PetVida</a>
    </div>

    <nav class="hidden md:flex items-center gap-2">
      {navItems.map((item) => (
        <a
          href={item.href}
          class={`nav-item ${currentPath === item.href ? 'active' : ''}`}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="hidden md:block">
      <a
        href="/adopta"
        class="nav-cta"
      >
        Adoptar un peludo
      </a>
    </div>

    <button id="menu-toggle" type="button" class="md:hidden p-2 text-stone-700 hover-highlight rounded-lg" aria-label="Abrir menú">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
      </svg>
    </button>
  </div>

  <div id="mobile-menu" class="md:hidden hidden border-t border-stone-200/60 bg-white/95 backdrop-blur-md">
    <nav class="flex flex-col px-4 py-4 space-y-2 text-sm font-medium">
      {navItems.map((item) => (
        <a
          href={item.href}
          class={`mobile-item ${currentPath === item.href ? 'mobile-item-active' : ''}`}
        >
          {item.label}
        </a>
      ))}
      <a href="/adopta" class="mt-3 inline-flex items-center justify-center px-4 h-10 text-sm font-medium text-white nav-cta">
        Adoptar un peludo
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const isOpen = !menu.classList.contains('hidden');
      menu.classList.toggle('hidden');
      toggle.setAttribute('aria-label', isOpen ? 'Abrir menú' : 'Cerrar menú');
      toggle.setAttribute('aria-expanded', String(!isOpen));
      toggle.innerHTML = isOpen
        ? `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" /></svg>`
        : `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>`;
    });
  }
</script>
