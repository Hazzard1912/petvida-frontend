---

---

<header class="sticky top-0 z-40 w-full bg-white/80 backdrop-blur-md border-b border-stone-200/60 shadow-xs">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <div class="flex items-center gap-2">
      <span class="text-2xl">🐾</span>
      <a href="/" class="text-xl font-bold tracking-tight text-emerald-700 hover:text-emerald-600 transition-colors">
        PetVida
      </a>
    </div>

    <nav class="hidden md:flex items-center gap-6 text-sm font-medium">
      <a href="/" class="text-emerald-700 font-semibold">Inicio</a>
      <a href="/adopta" class="text-stone-600 hover:text-emerald-600 transition-colors">Adoptar</a>
      <a href="/ayudanos" class="text-stone-600 hover:text-emerald-600 transition-colors">Donar</a>
      <a href="/noticias" class="text-stone-600 hover:text-emerald-600 transition-colors">Noticias</a>
      <a href="/contacto" class="text-stone-600 hover:text-emerald-600 transition-colors">Contacto</a>
    </nav>

    <div class="hidden md:block">
      <a
        href="/adopta"
        class="inline-flex items-center justify-center px-4 h-9 text-sm font-medium text-white bg-emerald-600 hover:bg-emerald-700 rounded-lg shadow-xs transition-colors"
      >
        Adoptar un peludo
      </a>
    </div>

    <button id="menu-toggle" type="button" class="md:hidden p-2 text-stone-700 hover:text-emerald-600 transition-colors rounded-lg" aria-label="Abrir menú">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
      </svg>
    </button>
  </div>

  <div id="mobile-menu" class="md:hidden hidden border-t border-stone-200/60 bg-white/95 backdrop-blur-md">
    <nav class="flex flex-col px-4 py-4 space-y-1 text-sm font-medium">
      <a href="/" class="text-emerald-700 font-semibold px-3 py-2.5 rounded-lg hover:bg-emerald-50 transition-colors">Inicio</a>
      <a href="/adopta" class="text-stone-600 hover:text-emerald-600 transition-colors px-3 py-2.5 rounded-lg hover:bg-emerald-50 transition-colors">Adoptar</a>
      <a href="/ayudanos" class="text-stone-600 hover:text-emerald-600 transition-colors px-3 py-2.5 rounded-lg hover:bg-emerald-50 transition-colors">Donar</a>
      <a href="/noticias" class="text-stone-600 hover:text-emerald-600 transition-colors px-3 py-2.5 rounded-lg hover:bg-emerald-50 transition-colors">Noticias</a>
      <a href="/contacto" class="text-stone-600 hover:text-emerald-600 transition-colors px-3 py-2.5 rounded-lg hover:bg-emerald-50 transition-colors">Contacto</a>
      <a href="/adopta" class="mt-3 inline-flex items-center justify-center px-4 h-10 text-sm font-medium text-white bg-emerald-600 hover:bg-emerald-700 rounded-lg shadow-xs transition-colors">
        Adoptar un peludo
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const isOpen = !menu.classList.contains('hidden');
      menu.classList.toggle('hidden');
      toggle.setAttribute('aria-label', isOpen ? 'Abrir menú' : 'Cerrar menú');
      toggle.setAttribute('aria-expanded', String(!isOpen));
      toggle.innerHTML = isOpen
        ? `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" /></svg>`
        : `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>`;
    });
  }
</script>
