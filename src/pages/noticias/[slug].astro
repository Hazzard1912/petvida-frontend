---
import Layout from '../../layouts/Layout.astro';
import { getNoticiaBySlug, getNoticias } from '../../lib/strapi';
import type { INoticia } from '../../types/strapi';

export const prerender = false;

const { slug } = Astro.params;

let noticia: INoticia | null = null;
let related: INoticia[] = [];

if (slug) {
  noticia = await getNoticiaBySlug(slug);
  if (noticia) {
    const all = await getNoticias();
    related = all.filter((n) => n.documentId !== noticia!.documentId).slice(0, 3);
  }
}

if (!noticia) {
  return Astro.redirect('/noticias');
}

const fechaFormateada = new Date(noticia.fecha).toLocaleDateString('es-CO', {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
});

const seoTitle = `${noticia.titulo} | PetVida`;
const seoDescription = noticia.resumen;
const imageUrl = noticia.imagen?.url ?? '/foto.png';
---

<Layout title={seoTitle} description={seoDescription} ogTitle={noticia.titulo} ogDescription={noticia.resumen} ogImage={imageUrl}>
  <main class="bg-white">
    <article class="py-12 lg:py-16">
      <div class="max-w-3xl mx-auto px-4">

        <nav aria-label="Breadcrumb" class="flex items-center gap-1.5 text-sm text-stone-500 flex-wrap mb-8">
          <a href="/" class="hover:text-[var(--color-primary)] transition">Inicio</a>
          <span aria-hidden="true" class="text-stone-300">/</span>
          <a href="/noticias" class="hover:text-[var(--color-primary)] transition">Noticias</a>
          <span aria-hidden="true" class="text-stone-300">/</span>
          <span class="text-stone-700 font-medium truncate max-w-xs">{noticia.titulo}</span>
        </nav>

        <header class="mb-8">
          <time datetime={noticia.fecha} class="inline-block text-xs font-semibold uppercase tracking-[0.18em] text-[var(--color-secondary)] mb-3" style="font-family: var(--font-ui);">
            {fechaFormateada}
          </time>
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-stone-900 leading-tight" style="font-family: var(--font-display);">
            {noticia.titulo}
          </h1>
        </header>

        {noticia.imagen?.url && (
          <figure class="mb-10 overflow-hidden rounded-3xl bg-stone-100">
            <img
              src={noticia.imagen.url}
              alt={noticia.imagen.alternativeText || noticia.titulo}
              class="w-full h-auto max-h-[520px] object-cover"
              loading="eager"
            />
          </figure>
        )}

        {noticia.resumen && (
          <blockquote class="mb-10 border-l-4 border-[var(--color-primary)] bg-[color:var(--color-pastel)] rounded-r-2xl px-6 py-4 italic text-stone-700">
            {noticia.resumen}
          </blockquote>
        )}

        <div class="contenido-noticia" set:html={noticia.contenido} />

        <hr class="my-12 border-stone-200" />

        <div class="flex justify-center">
          <a href="/noticias" class="inline-flex items-center gap-2 rounded-full bg-[var(--color-primary)] px-6 py-3 text-sm font-semibold text-white transition hover:opacity-90" style="font-family: var(--font-ui);">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
            </svg>
            Volver a noticias
          </a>
        </div>
      </div>
    </article>

    {related.length > 0 && (
      <section class="py-16 bg-[var(--color-surface)]">
        <div class="max-w-5xl mx-auto px-4">
          <h2 class="text-2xl font-bold text-stone-900 mb-8" style="font-family: var(--font-display);">
            Otras noticias
          </h2>
          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {related.map((item) => (
              <a href={`/noticias/${item.slug}`} class="group block rounded-3xl bg-white shadow-sm border border-stone-100 overflow-hidden hover:shadow-md transition">
                {item.imagen?.url ? (
                  <div class="aspect-[16/10] overflow-hidden bg-stone-100">
                    <img src={item.imagen.url} alt={item.titulo} class="w-full h-full object-cover transition duration-500 group-hover:scale-105" loading="lazy" />
                  </div>
                ) : (
                  <div class="aspect-[16/10] bg-[var(--color-pastel)]" />
                )}
                <div class="p-5">
                  <time class="text-xs font-semibold uppercase tracking-[0.18em] text-[var(--color-secondary)]" style="font-family: var(--font-ui);">
                    {new Date(item.fecha).toLocaleDateString('es-CO', { day: '2-digit', month: 'short', year: 'numeric' })}
                  </time>
                  <h3 class="mt-2 text-lg font-semibold text-stone-800 line-clamp-2">{item.titulo}</h3>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}
  </main>
</Layout>
