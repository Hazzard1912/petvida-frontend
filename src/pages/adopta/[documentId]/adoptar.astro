---
import Layout from '../../../layouts/Layout.astro';
import FormularioAdopcion from '../../../components/FormularioAdopcion.astro';
import { getPetByDocumentId } from '../../../lib/strapi';
import type { IPet } from '../../../types/strapi';

export const prerender = false;

const { documentId } = Astro.params;

let pet: IPet | undefined;
if (documentId) {
  const response = await getPetByDocumentId(documentId);
  pet = response?.data?.[0] as IPet | undefined;
}

if (!pet) {
  return Astro.redirect('/404');
}

if (pet.isAdopted) {
  return Astro.redirect(`/adopta/${documentId}`);
}

const seoTitle = `Solicitar adopcion de ${pet.name} | PetVida`;
const seoDescription = `Manifiesta tu interes para que nuestro equipo te contacte y puedas iniciar el proceso de adopcion de ${pet.name}. Completa el formulario y te guiaremos en cada paso.`;
---

<Layout title={seoTitle} description={seoDescription}>
  <main class="bg-[var(--color-surface)] min-h-screen py-16">
    <div class="max-w-5xl mx-auto px-4">
      <nav aria-label="Breadcrumb" class="flex items-center gap-1.5 text-sm text-stone-500 flex-wrap">
        <a href="/" class="hover:text-[var(--color-primary)] transition">Inicio</a>
        <span aria-hidden="true" class="text-stone-300">/</span>
        <a href="/adopta" class="hover:text-[var(--color-primary)] transition">Mascotas en adopcion</a>
        <span aria-hidden="true" class="text-stone-300">/</span>
        <a href={`/adopta/${pet.documentId}`} class="hover:text-[var(--color-primary)] transition">{pet.name}</a>
        <span aria-hidden="true" class="text-stone-300">/</span>
        <span class="text-stone-700 font-medium">Solicitar adopcion</span>
      </nav>

      <div class="mb-10">
        <a href={`/adopta/${pet.documentId}`} class="inline-flex items-center gap-2 text-[var(--color-primary)] hover:opacity-80 transition">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd" />
          </svg>
          <span>Volver al perfil de {pet.name}</span>
        </a>
      </div>

      <div class="mb-10 text-center">
        <h1 class="text-4xl font-extrabold text-stone-900 mb-4">Solicitar adopcion de {pet.name}</h1>
        <p class="text-stone-600 max-w-2xl mx-auto">
          Comparte tus datos y tu motivacion para que nuestro equipo pueda contactarte y juntos iniciar el proceso responsable de adopcion de {pet.name}.
        </p>
      </div>

      <FormularioAdopcion pet={{ documentId: pet.documentId, name: pet.name }} />

      <div class="mt-12 bg-white p-8 rounded-3xl shadow-sm">
        <h3 class="text-2xl font-bold text-stone-900 mb-6">Que sigue despues de enviar la solicitud?</h3>

        <ol class="space-y-6">
          <li class="flex gap-4 items-start">
            <div class="flex-shrink-0 flex items-center justify-center w-10 h-10 rounded-full bg-[color:var(--color-pastel)] text-[var(--color-primary)] font-bold">1</div>
            <div>
              <h4 class="text-lg font-semibold text-stone-800 mb-1">Revision inicial</h4>
              <p class="text-stone-600">Nuestro equipo revisara tu interes, validara la informacion y se pondra en contacto contigo por telefono o email en un maximo de 48 horas.</p>
            </div>
          </li>
          <li class="flex gap-4 items-start">
            <div class="flex-shrink-0 flex items-center justify-center w-10 h-10 rounded-full bg-[color:var(--color-pastel)] text-[var(--color-primary)] font-bold">2</div>
            <div>
              <h4 class="text-lg font-semibold text-stone-800 mb-1">Entrevista y visita</h4>
              <p class="text-stone-600">Programaremos una entrevista personal y, de ser necesario, una visita a tu hogar para asegurarnos de que sea un ambiente adecuado.</p>
            </div>
          </li>
          <li class="flex gap-4 items-start">
            <div class="flex-shrink-0 flex items-center justify-center w-10 h-10 rounded-full bg-[color:var(--color-pastel)] text-[var(--color-primary)] font-bold">3</div>
            <div>
              <h4 class="text-lg font-semibold text-stone-800 mb-1">Periodo de adopcion</h4>
              <p class="text-stone-600">Si todo avanza positivamente, podras iniciar un periodo de adopcion con {pet.name} mientras completamos los tramites formales.</p>
            </div>
          </li>
          <li class="flex gap-4 items-start">
            <div class="flex-shrink-0 flex items-center justify-center w-10 h-10 rounded-full bg-[color:var(--color-pastel)] text-[var(--color-primary)] font-bold">4</div>
            <div>
              <h4 class="text-lg font-semibold text-stone-800 mb-1">Adopcion oficial</h4>
              <p class="text-stone-600">Finalizaremos el proceso con la firma del contrato de adopcion y {pet.name} pasara oficialmente a ser parte de tu familia.</p>
            </div>
          </li>
        </ol>
      </div>
    </div>
  </main>
</Layout>
