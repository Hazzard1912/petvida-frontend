---
export const prerender = false;

import Layout from "../layouts/Layout.astro";
import MisionVision from "../components/MisionVision.astro";
import NoticiasGrid from "../components/NoticiasGrid.astro";
import HistoriasFelices from "../components/HistoriasFelices.astro";
import FAQ from "../components/FAQ.astro";
import { strapiFetch, getFAQ, getHappyEndings } from "../lib/strapi";
import type { StrapiSingleResponse, IHomepage, IPet } from "../types/strapi";
import type { IFaq } from "../lib/strapi";

const defaultHomepage: IHomepage = {
	id: 0,
	documentId: "",
	heroTitle: "Cada huella merece una segunda oportunidad",
	heroSubtitle:
		"Rescatamos, protegemos y encontramos hogares llenos de amor para animales que merecen una nueva oportunidad.",
	misionTitle: "Nuestra Misión",
	misionContent:
		"Rescatar, rehabilitar y encontrar hogares responsables para animales en situación de calle en Cali, promoviendo la tenencia responsable y el respeto por la vida animal.",
	visionTitle: "Nuestra Visión",
	visionContent:
		"Ser un refugio de referencia en el suroccidente colombiano, reconocido por nuestra labor ética, la educación comunitaria y el impacto sostenible en el bienestar animal.",
	historiaTitle: "Nuestra Historia",
	historiaContent:
		"Huellas de Esperanza nació en Cali como un proyecto académico que pronto se convirtió en una causa ciudadana. Desde nuestros primeros rescates callejeros hasta hoy, cada peludo adoptado es un recordatorio de que el cambio empieza con pequeñas acciones colectivas.",
	createdAt: "",
	updatedAt: "",
	publishedAt: "",
};

let homepageData: IHomepage = defaultHomepage;
let faqData: IFaq | null = null;
let adoptedPets: IPet[] = [];

const [homepageResponse, faqResponse, happyEndingsResponse] = await Promise.allSettled([
	strapiFetch<StrapiSingleResponse<IHomepage>>("homepage"),
	getFAQ(),
	getHappyEndings(),
]);

if (homepageResponse.status === "fulfilled" && homepageResponse.value?.data) {
	homepageData = homepageResponse.value.data;
} else {
	console.error(
		"No se pudo conectar con Strapi. Usando datos locales de respaldo.",
	);
}

if (faqResponse.status === "fulfilled" && faqResponse.value) {
	faqData = faqResponse.value;
}

if (happyEndingsResponse.status === "fulfilled" && happyEndingsResponse.value) {
	adoptedPets = happyEndingsResponse.value;
}

const heroTitleParts = homepageData.heroTitle
	.toLowerCase()
	.includes("segunda oportunidad")
	? {
			intro: "Cada huella merece",
			highlight: "una segunda oportunidad",
		}
	: {
			intro: homepageData.heroTitle,
			highlight: "",
		};
---

<Layout title="Inicio - Rescate y Adopción Animal">
	<section class="hero-section">
		<div class="hero-blob hero-blob-right"></div>
		<div class="hero-blob hero-blob-behind-img"></div>
		<div class="hero-blob hero-blob-pink-cloud"></div>
		<div class="hero-blob hero-blob-left"></div>

		<div class="hero-decor hero-paw hero-paw-large"></div>
		<div class="hero-decor hero-paw hero-paw-small"></div>
		<div class="hero-decor hero-paw hero-paw-top"></div>
		<div class="hero-decor hero-bone hero-bone-left"></div>
		<div class="hero-decor hero-bone hero-bone-center"></div>
		<div class="hero-decor hero-bone hero-bone-right"></div>

		<div class="hero-container">
			<div class="hero-content">
				<h1 class="hero-title">
					<span class="hero-title-dark">{heroTitleParts.intro}</span>
					{
						heroTitleParts.highlight && (
							<span class="hero-title-pink">
								{heroTitleParts.highlight}
							</span>
						)
					}
				</h1>
				<p class="hero-subtitle">
					{homepageData.heroSubtitle}
				</p>

				<div class="hero-actions">
					<a href="/adopta" class="hero-btn hero-btn-primary">
						<span class="btn-icon-paw" aria-hidden="true">🐾</span>
						Ver Mascotas
					</a>
					<a href="/ayudanos" class="hero-btn hero-btn-secondary">
						<svg
							width="20"
							height="20"
							viewBox="0 0 24 24"
							fill="white"
							xmlns="http://www.w3.org/2000/svg"
							style="display: block; width: 20px; height: 20px; margin-right: 0.6rem;"
						>
							<path
								d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
							/>
						</svg>
						Quiero Ayudar
					</a>
				</div>
			</div>

			<div class="hero-image" aria-hidden="true">
				<img src="/foto.png" alt="Perro y gato felices" loading="eager" />
			</div>
		</div>
	</section>

	<MisionVision data={homepageData} />
	<NoticiasGrid />
	<section class="w-screen relative left-1/2 right-1/2 -mx-[50vw] py-16" style="background: linear-gradient(180deg, #FFF5FA 0%, #FFE8F0 100%);">
		<div class="max-w-4xl mx-auto px-4 text-center">
			<div class="inline-flex items-center justify-center w-14 h-14 rounded-full bg-white shadow-sm mb-4">
				<span class="text-3xl">🐾</span>
			</div>
			<h2 class="text-3xl sm:text-4xl font-extrabold text-stone-900 mb-3" style="font-family: var(--font-display);">
				Listo para <span class="text-[var(--color-primary)]">cambiar una vida</span>?
			</h2>
			<p class="text-stone-600 max-w-xl mx-auto mb-7" style="font-family: var(--font-body);">
				Explora nuestro catalogo y conoce a los peludos que esperan encontrar un hogar lleno de amor.
			</p>
			<a
				href="/adopta"
				class="inline-flex items-center gap-2 rounded-full bg-[var(--color-primary)] text-white px-7 py-3.5 font-semibold shadow-md hover:shadow-lg hover:opacity-90 transition" style="font-family: var(--font-ui);"
			>
				Ver mascotas en adopcion
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4">
					<path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd" />
				</svg>
			</a>
		</div>
	</section>
	<HistoriasFelices pets={adoptedPets} />
	<FAQ faqData={faqData} />
</Layout>
