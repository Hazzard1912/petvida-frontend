---
import Layout from '../layouts/Layout.astro';
import MisionVision from '../components/MisionVision.astro';
import NoticiasGrid from '../components/NoticiasGrid.astro';
import { strapiFetch } from '../lib/strapi';
import type { StrapiSingleResponse, IHomepage } from '../types/strapi';

const defaultHomepage: IHomepage = {
	id: 0,
	documentId: '',
	heroTitle: 'Segunda oportunidad para peludos',
	heroSubtitle: 'Refugio con sede en Cali, impulsado por voluntarios, padrinos y donantes dedicados al rescate animal.',
	misionTitle: 'Nuestra Misión',
	misionContent: 'Rescatar, rehabilitar y encontrar hogares responsables para animales en situación de calle en Cali, promoviendo la tenencia responsable y el respeto por la vida animal.',
	visionTitle: 'Nuestra Visión',
	visionContent: 'Ser un refugio de referencia en el suroccidente colombiano, reconocido por nuestra labor ética, la educación comunitaria y el impacto sostenible en el bienestar animal.',
	historiaTitle: 'Nuestra Historia',
	historiaContent: 'Huellas de Esperanza nació en Cali como un proyecto académico que pronto se convirtió en una causa ciudadana. Desde nuestros primeros rescates callejeros hasta hoy, cada peludo adoptado es un recordatorio de que el cambio empieza con pequeñas acciones colectivas.',
	createdAt: '',
	updatedAt: '',
	publishedAt: '',
};

let homepageData: IHomepage = defaultHomepage;
let connectionError = false;

try {
	const response = await strapiFetch<StrapiSingleResponse<IHomepage>>('homepage');
	if (response?.data) {
		homepageData = response.data;
	}
} catch (error) {
	console.error('No se pudo conectar con Strapi. Usando datos locales de respaldo.');
	connectionError = true;
}
---

<Layout title="Inicio - Rescate y Adopción Animal">
	{connectionError && (
		<div class="fixed bottom-4 left-4 z-50 inline-flex items-center px-3 py-1.5 text-xs font-medium text-amber-800 bg-amber-100 rounded-full shadow-xs">
			Modo offline — datos de respaldo
		</div>
	)}

	<section class="py-16 md:py-28 text-center">
		<h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-stone-900 max-w-3xl mx-auto leading-tight">
			{homepageData.heroTitle}
		</h1>
		<p class="mt-4 text-base sm:text-lg text-stone-600 max-w-2xl mx-auto leading-relaxed">
			{homepageData.heroSubtitle}
		</p>

		<div class="mt-8 flex items-center justify-center gap-4">
			<a
				href="/adopta"
				class="inline-flex items-center justify-center px-6 h-12 font-medium text-white bg-emerald-600 hover:bg-emerald-700 rounded-xl shadow-md transition-colors"
			>
				Ver Mascotas
			</a>
			<a
				href="/ayudanos"
				class="inline-flex items-center justify-center px-6 h-12 font-medium text-emerald-700 bg-emerald-100 hover:bg-emerald-200 rounded-xl transition-colors"
			>
				Quiero Ayudar
			</a>
		</div>
	</section>

	<MisionVision data={homepageData} />

	<NoticiasGrid />
</Layout>