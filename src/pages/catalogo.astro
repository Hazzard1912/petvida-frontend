---
import Layout from '../layouts/Layout.astro';
import { getProductos } from '../lib/strapi';
import type { IProducto } from '../types/strapi';

export const prerender = false;

const WHATSAPP_NUMBER = import.meta.env.PUBLIC_WHATSAPP_TIENDA ?? '57XXXXXXXXXX';
const PLACEHOLDER_NUMBER = WHATSAPP_NUMBER === '57XXXXXXXXXX';

let productos: IProducto[] = [];

try {
  productos = await getProductos();
} catch (error) {
  console.error('No se pudieron cargar los productos desde Strapi.', error);
}

const formatPrice = (value: number): string => {
  if (!value) return '';
  return `$${value.toLocaleString('es-CO')}`;
};

const buildWhatsappLink = (producto: IProducto): string => {
  const message = producto.whatsappMensaje && producto.whatsappMensaje.trim().length > 0
    ? producto.whatsappMensaje
    : `Hola PetVida, me interesa comprar: ${producto.nombre}`;
  return `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(message)}`;
};

const featured = productos.find((p) => p.destacado);
const catalog = productos.filter((p) => !p.destacado);
---

<Layout
  title="Catalogo Solidario | PetVida"
  description="Apoya a la fundacion adquiriendo productos solidarios. Compra por WhatsApp y contribuye directamente al cuidado de nuestros peludos."
>
  <!-- HERO -->
  <section class="relative overflow-hidden py-20 lg:py-24" style="background: linear-gradient(180deg, #FFF5FA 0%, #FFE8F0 100%);">
    <div class="max-w-5xl mx-auto px-4 text-center relative z-10">
      <span class="inline-block rounded-full bg-[var(--color-pastel)] px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.18em] text-[var(--color-primary)] font-[family-name:var(--font-ui)]">
        Tu compra transforma vidas
      </span>
      <h1 class="mt-6 text-4xl sm:text-5xl lg:text-6xl font-extrabold text-stone-900" style="font-family: var(--font-display);">
        Catalogo <span class="text-[var(--color-primary)]">Solidario</span>
      </h1>
      <p class="mt-4 text-base sm:text-lg text-stone-600 max-w-2xl mx-auto" style="font-family: var(--font-body);">
        Cada producto que adquieres ayuda directamente al cuidado, alimentacion y atencion veterinaria de los peludos del refugio.
      </p>
    </div>
  </section>

  <!-- PRODUCTO DESTACADO -->
  {featured && (
    <section class="py-16 bg-white">
      <div class="max-w-5xl mx-auto px-4">
        <div class="rounded-3xl bg-[var(--color-surface)] border border-stone-100 shadow-sm overflow-hidden">
          <div class="grid md:grid-cols-2 gap-0">
            <div class="relative bg-[var(--color-pastel)] flex items-center justify-center p-10">
              {featured.imagen?.url ? (
                <img src={featured.imagen.url} alt={featured.imagen.alternativeText || featured.nombre} class="w-full max-h-[420px] object-contain" loading="eager" />
              ) : (
                <div class="w-full h-72 flex items-center justify-center text-6xl">🛍️</div>
              )}
              <span class="absolute top-4 left-4 inline-flex items-center gap-1 rounded-full bg-[var(--color-primary)] text-white text-xs font-bold uppercase tracking-wider px-3 py-1.5" style="font-family: var(--font-ui);">
                Destacado
              </span>
            </div>

            <div class="p-8 md:p-10 flex flex-col justify-center">
              <h2 class="text-2xl sm:text-3xl font-extrabold text-stone-900" style="font-family: var(--font-display);">
                {featured.nombre}
              </h2>
              <p class="mt-2 text-3xl font-extrabold text-[var(--color-primary)]" style="font-family: var(--font-title);">
                {formatPrice(featured.precio)}
              </p>
              <p class="mt-4 text-stone-600 leading-relaxed" style="font-family: var(--font-body);">
                {featured.descripcion}
              </p>
              <a
                href={PLACEHOLDER_NUMBER ? '#' : buildWhatsappLink(featured)}
                target={PLACEHOLDER_NUMBER ? undefined : '_blank'}
                rel={PLACEHOLDER_NUMBER ? undefined : 'noopener noreferrer'}
                class:list={[
                  'mt-6 inline-flex items-center justify-center gap-2 rounded-xl px-6 py-3.5 font-semibold transition shadow-sm',
                  PLACEHOLDER_NUMBER
                    ? 'bg-stone-300 text-stone-500 cursor-not-allowed'
                    : 'bg-[#25D366] text-white hover:bg-[#1FB857] hover:shadow-md'
                ]}
                style="font-family: var(--font-ui);"
                aria-disabled={PLACEHOLDER_NUMBER}
              >
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                {PLACEHOLDER_NUMBER ? 'Configurar WhatsApp en .env' : 'Comprar por WhatsApp'}
              </a>
              {PLACEHOLDER_NUMBER && (
                <p class="mt-2 text-xs text-stone-400 italic">Numero de WhatsApp pendiente de configurar por la fundacion.</p>
              )}
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- CATALOGO -->
  <section class="py-16 bg-[var(--color-surface)]">
    <div class="max-w-6xl mx-auto px-4">
      <div class="text-center mb-12">
        <p class="eyebrow text-sm uppercase tracking-[0.22em] font-semibold text-[var(--color-secondary)] font-[family-name:var(--font-ui)]">
          Todos los productos
        </p>
        <h2 class="mt-3 text-3xl sm:text-4xl font-extrabold text-stone-900" style="font-family: var(--font-display);">
          Apoya con cada <span class="text-[var(--color-primary)]">compra</span>
        </h2>
      </div>

      {catalog.length > 0 ? (
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {catalog.map((producto) => (
            <article class="group rounded-3xl bg-white border border-stone-100 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all duration-300 flex flex-col overflow-hidden">
              <div class="aspect-[4/3] bg-[var(--color-pastel)] flex items-center justify-center overflow-hidden">
                {producto.imagen?.url ? (
                  <img src={producto.imagen.url} alt={producto.imagen.alternativeText || producto.nombre} class="w-full h-full object-contain transition duration-500 group-hover:scale-105" loading="lazy" />
                ) : (
                  <span class="text-5xl">🛍️</span>
                )}
              </div>

              <div class="p-6 flex flex-col grow">
                <div class="flex items-start justify-between gap-3 mb-2">
                  <h3 class="text-lg font-bold text-stone-900 leading-snug line-clamp-2" style="font-family: var(--font-title);">
                    {producto.nombre}
                  </h3>
                  <span class="flex-shrink-0 text-base font-extrabold text-[var(--color-primary)]" style="font-family: var(--font-title);">
                    {formatPrice(producto.precio)}
                  </span>
                </div>
                <p class="text-sm text-stone-600 leading-relaxed line-clamp-3 mb-5" style="font-family: var(--font-body);">
                  {producto.descripcion}
                </p>
                <a
                  href={PLACEHOLDER_NUMBER ? '#' : buildWhatsappLink(producto)}
                  target={PLACEHOLDER_NUMBER ? undefined : '_blank'}
                  rel={PLACEHOLDER_NUMBER ? undefined : 'noopener noreferrer'}
                  class:list={[
                    'mt-auto inline-flex items-center justify-center gap-2 rounded-xl px-4 py-2.5 text-sm font-semibold transition',
                    PLACEHOLDER_NUMBER
                      ? 'bg-stone-200 text-stone-500 cursor-not-allowed'
                      : 'bg-[#25D366] text-white hover:bg-[#1FB857]'
                  ]}
                  style="font-family: var(--font-ui);"
                  aria-disabled={PLACEHOLDER_NUMBER}
                >
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                  {PLACEHOLDER_NUMBER ? 'Pendiente configurar WhatsApp' : 'Comprar por WhatsApp'}
                </a>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="text-center py-16 rounded-3xl bg-white border border-stone-100">
          <span class="text-5xl">🛍️</span>
          <p class="mt-4 text-stone-500" style="font-family: var(--font-body);">
            Aun no hay productos disponibles. Vuelve pronto.
          </p>
        </div>
      )}

      <p class="mt-12 text-center text-sm text-stone-500" style="font-family: var(--font-body);">
        La disponibilidad de los productos puede variar. Escribenos por WhatsApp para confirmar existencias.
      </p>
    </div>
  </section>
</Layout>
