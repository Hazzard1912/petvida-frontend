---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { getNoticias } from '../lib/strapi';
import type { INoticia } from '../types/strapi';

let noticias: INoticia[] = [];

try {
  noticias = await getNoticias();
} catch (error) {
  console.error('No se pudieron cargar las noticias desde Strapi.', error);
}

const formatDate = (dateStr: string): string => {
  if (!dateStr) return '';
  return new Date(dateStr).toLocaleDateString('es-CO', {
    day: '2-digit',
    month: 'long',
    year: 'numeric',
  });
};
---

<Layout title="Noticias | PetVida" description="Entérate de las ultimas actividades, campanas y eventos de la fundacion.">
  <section class="py-16 md:py-24 bg-[var(--color-surface)]">
    <div class="max-w-6xl mx-auto px-4">
      <div class="text-center mb-14">
        <p class="eyebrow text-sm uppercase tracking-[0.22em] font-semibold text-[var(--color-secondary)] font-[family-name:var(--font-ui)]">
          Lo que pasa en el refugio
        </p>
        <h1 class="mt-3 text-4xl sm:text-5xl font-extrabold text-stone-900" style="font-family: var(--font-display);">
          Noticias
        </h1>
        <p class="mt-3 text-stone-600 max-w-xl mx-auto leading-relaxed" style="font-family: var(--font-body);">
          Campañas, eventos, historias de rescate y todo lo que hacemos por nuestros peludos.
        </p>
      </div>

      {noticias.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
          {noticias.map((noticia) => (
            <article class="group bg-white rounded-3xl border border-stone-100 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all duration-200 flex flex-col overflow-hidden">
              <a href={`/noticias/${noticia.slug}`} class="block">
                {noticia.imagen?.url ? (
                  <div class="aspect-[16/10] overflow-hidden bg-stone-100">
                    <img
                      src={noticia.imagen.url}
                      alt={noticia.imagen.alternativeText || noticia.titulo}
                      class="w-full h-full object-cover transition duration-500 group-hover:scale-105"
                      loading="lazy"
                    />
                  </div>
                ) : (
                  <div class="aspect-[16/10] bg-[var(--color-pastel)] flex items-center justify-center">
                    <span class="text-4xl">🐾</span>
                  </div>
                )}
              </a>

              <div class="p-6 flex flex-col grow">
                <time class="text-xs font-semibold uppercase tracking-[0.18em] text-[var(--color-secondary)] mb-2" style="font-family: var(--font-ui);" datetime={noticia.fecha}>
                  {formatDate(noticia.fecha)}
                </time>
                <h2 class="text-lg font-bold text-stone-900 mb-2 leading-snug line-clamp-2 group-hover:text-[var(--color-primary)] transition-colors" style="font-family: var(--font-title);">
                  {noticia.titulo}
                </h2>
                <p class="text-sm text-stone-600 leading-relaxed line-clamp-3 mb-4" style="font-family: var(--font-body);">
                  {noticia.resumen}
                </p>
                <a
                  href={`/noticias/${noticia.slug}`}
                  class="mt-auto inline-flex items-center gap-1 text-sm font-semibold text-[var(--color-primary)] hover:opacity-80 transition-colors"
                  style="font-family: var(--font-ui);"
                >
                  Leer más
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4">
                    <path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd" />
                  </svg>
                </a>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="text-center py-20 rounded-3xl bg-white border border-stone-100">
          <span class="text-5xl">🐾</span>
          <p class="mt-4 text-stone-500" style="font-family: var(--font-body);">No hay noticias disponibles por el momento.</p>
        </div>
      )}
    </div>
  </section>
</Layout>
