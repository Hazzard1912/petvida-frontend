# URL de conexión local al headless CMS
PUBLIC_STRAPI_URL=http://localhost:1337

# Token de lectura (Read-Only) generado desde Settings -> API Tokens en Strapi
STRAPI_API_TOKEN=tu_api_token_aqui

# Token con permisos de escritura (Create/Update) para crear solicitudes de adopcion/apadrinamiento
# Debes crearlo en Strapi Admin → Settings → API Tokens → con permisos para: adopter, sponsor, adoption-request, sponsor-request
STRAPI_REQUEST_TOKEN=tu_token_de_escritura_aqui

# Numero de WhatsApp para el catalogo solidario (formato: codigo pais + numero, sin + ni espacios)
# Ejemplo Colombia: 573001234567
PUBLIC_WHATSAPP_TIENDA=57XXXXXXXXXX